{
  "name": "@brightkumedzro/reveal",
  "version": "1.0.0",
  "description": "Scroll-driven WebGL2 reveals between any two images, in two packs: elemental (fire, water, air, earth, lightning) and shinobi (clone, vortex, spiral, blade, storm, twister). Optional synthesised sound. No dependencies.",
  "type": "module",
  "main": "js/lib.js",
  "module": "js/lib.js",
  "exports": {
    ".": "./js/lib.js",
    "./elemental": "./js/elemental/index.js",
    "./shinobi": "./js/shinobi/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "js/lib.js",
    "js/reveal.js",
    "js/core.js",
    "js/sound.js",
    "js/elemental/index.js",
    "js/elemental/fire.js",
    "js/elemental/water.js",
    "js/elemental/air.js",
    "js/elemental/earth.js",
    "js/elemental/lightning.js",
    "js/elemental/sfx.js",
    "js/shinobi/index.js",
    "js/shinobi/clone.js",
    "js/shinobi/vortex.js",
    "js/shinobi/spiral.js",
    "js/shinobi/blade.js",
    "js/shinobi/storm.js",
    "js/shinobi/twister.js",
    "js/shinobi/sfx.js",
    "js/shinobi/sfx-storm.js",
    "js/shinobi/sfx-twister.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "webgl",
    "webgl2",
    "shader",
    "reveal",
    "scroll",
    "fire",
    "water",
    "transition",
    "effect",
    "sound",
    "web-audio",
    "earth",
    "air",
    "lightning",
    "sand",
    "tornado",
    "sandstorm",
    "anime"
  ],
  "author": "Bright Kumedzro",
  "license": "MIT",
  "homepage": "https://elemental-reveal.vercel.app/use",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bright-kumedzro/elemental-reveal.git"
  },
  "bugs": {
    "url": "https://github.com/bright-kumedzro/elemental-reveal/issues"
  },
  "scripts": {
    "pages": "node scripts/pages.mjs",
    "serve": "python -m http.server 5179"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.1"
  }
}
