{
  "name": "@brightkumedzro/reveal",
  "version": "1.3.0",
  "description": "Scroll effects in one library: WebGL2 reveals between any two images, in three packs (elemental, shinobi, paper), and scrollytelling effects for your own content (words, count, lines, mask, steps, scrub, zoom). Optional synthesised sound. No dependencies, no network requests.",
  "type": "module",
  "main": "js/lib.js",
  "module": "js/lib.js",
  "exports": {
    ".": "./js/lib.js",
    "./elemental": "./js/elemental/index.js",
    "./shinobi": "./js/shinobi/index.js",
    "./paper": "./js/paper/index.js",
    "./scroll": "./js/scroll/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "js/**/*.js",
    "!js/main.js",
    "!js/**/lab.js",
    "!js/**/_*.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "webgl",
    "webgl2",
    "shader",
    "reveal",
    "scroll",
    "fire",
    "water",
    "transition",
    "effect",
    "sound",
    "web-audio",
    "earth",
    "air",
    "lightning",
    "sand",
    "tornado",
    "sandstorm",
    "anime",
    "ice",
    "lava",
    "page-curl",
    "origami",
    "ink",
    "scrollytelling",
    "scroll-animation",
    "svg"
  ],
  "author": "Bright Kumedzro",
  "license": "MIT",
  "homepage": "https://reveal.brightkumedzro.com/use",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bright-kumedzro/reveal.git"
  },
  "bugs": {
    "url": "https://github.com/bright-kumedzro/reveal/issues"
  },
  "scripts": {
    "pages": "node scripts/pages.mjs",
    "serve": "python -m http.server 5179"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.1"
  }
}
