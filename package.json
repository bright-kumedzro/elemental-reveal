{
  "name": "@brightkumedzro/reveal",
  "version": "1.2.1",
  "description": "Scroll-driven WebGL2 reveals between any two images, in three packs: elemental (fire, water, air, earth, lightning, frost), shinobi (clone, vortex, spiral, blade, storm, twister, magma, shuriken) and paper (curl, fold, draw). Optional synthesised sound. No dependencies, no network requests.",
  "type": "module",
  "main": "js/lib.js",
  "module": "js/lib.js",
  "exports": {
    ".": "./js/lib.js",
    "./elemental": "./js/elemental/index.js",
    "./shinobi": "./js/shinobi/index.js",
    "./paper": "./js/paper/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "js/**/*.js",
    "!js/main.js",
    "!js/**/lab.js",
    "!js/**/_*.js",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "webgl",
    "webgl2",
    "shader",
    "reveal",
    "scroll",
    "fire",
    "water",
    "transition",
    "effect",
    "sound",
    "web-audio",
    "earth",
    "air",
    "lightning",
    "sand",
    "tornado",
    "sandstorm",
    "anime",
    "ice",
    "lava",
    "page-curl",
    "origami",
    "ink"
  ],
  "author": "Bright Kumedzro",
  "license": "MIT",
  "homepage": "https://reveal.brightkumedzro.com/use",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bright-kumedzro/reveal.git"
  },
  "bugs": {
    "url": "https://github.com/bright-kumedzro/reveal/issues"
  },
  "scripts": {
    "pages": "node scripts/pages.mjs",
    "serve": "python -m http.server 5179"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.2.1"
  }
}
